{
  "main": "toolchain",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc",
      "repos": [{"alias": "base_toolchain"}]
    },
    {
      "source": "git",
      "branch": "protobuf/v29.0",
      "config": "bundled.json",
      "url": "https://github.com/jst-build/imports-cc",
      "repos": [{"alias": "protobuf", "map": {"toolchain": "base_toolchain"}}]
    }
  ],
  "repositories": {
    "targets": {"repository": {"type": "file", "path": "targets"}},
    "toolchain": {
      "repository": "base_toolchain",
      "target_root": "targets",
      "rule_root": "base_toolchain",
      "bindings": {"base": "base_toolchain", "protobuf": "protobuf"}
    }
  }
}
