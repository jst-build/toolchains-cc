{
  defaults: {
    type: @'//CC/proto:defaults',
    PROTOC: ['protobuf/bin/protoc'],
    deps: [@'protobuf//:libprotobuf'],
    toolchain: ['protobuf_toolchain'],
  },

  'service defaults': {
    type: @'//CC/proto:defaults',
    base: ['defaults'],
    GRPC_PLUGIN: ["grpc/bin/grpc_cpp_plugin"],
    deps: [@'grpc//:grpc++'],
    toolchain: ['grpc_toolchain'],
  },

  // Restage Protobuf installation into subdirectory 'protobuf' so it does not
  // conflict with other potential toolchains.
  protobuf_toolchain: {
    type: 'install',
    dirs: [[@'protobuf//:INSTALL', 'protobuf']],
  },

  // Restage gRPC installation into subdirectory 'grpc' so it does not conflict
  // with other potential toolchains.
  grpc_toolchain: {
    type: 'install',
    dirs: [['grpc_binaries', 'grpc']],
  },

  grpc_binaries: {
    type: @'//CC:install-with-deps',
    targets: [@'grpc//:grpc_cpp_plugin'],
  },
}
